# Relixor Environment Configuration Template
# Copy this file to .env and customize the values for production deployment

# Application Environment
NODE_ENV=production
PORT=5000
APP_URL=http://localhost:8080
HTTP_PORT=8080

# Database Configuration (PostgreSQL)
POSTGRES_USER=relixor
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=relixor
POSTGRES_PORT=5434
DATABASE_URL=postgresql://relixor:replace_with_secure_postgres_password@postgres:5432/relixor?schema=public

# Security & Authentication
# Generate a secure string: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost,http://localhost:3000

# File Storage Configuration
# Supported providers: local (s3 ready)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/app/storage/apks
MAX_FILE_SIZE_MB=500

# S3 Configuration (Optional - when STORAGE_PROVIDER=s3)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=relixor-apks
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_FORCE_PATH_STYLE=false

# Initial Administrator Credentials (used by initial seed)
ADMIN_DEFAULT_EMAIL=admin@relixor.internal
ADMIN_DEFAULT_PASSWORD=ChangeMeImmediately123!
ADMIN_DEFAULT_NAME="System Administrator"
SEED_DEMO_DATA=false
